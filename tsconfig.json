{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "paths": {
      "@opencode/plugin": ["../opencode-v2-profile/packages/plugin/src/promise/index.ts"],
      "@opencode/plugin/tui": ["../opencode-v2-profile/packages/plugin/src/tui/index.ts"],
      "@opencode/plugin/rpc": ["../opencode-v2-profile/packages/plugin/src/rpc.ts"],
      "@opencode/plugin/*": ["../opencode-v2-profile/packages/plugin/src/promise/*"],
      "@opencode/schema/*": ["../opencode-v2-profile/packages/schema/src/*"],
      "@opencode/client/*": ["../opencode-v2-profile/packages/client/src/*"],
      "@opencode/ai": ["../opencode-v2-profile/packages/ai/src/index.ts"],
      "@opencode/ai/*": ["../opencode-v2-profile/packages/ai/src/*"]
    },

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["typecheck.ts", "server.ts", "tui.tsx", "rpc.ts", "src/**/*.ts", "src/**/*.tsx", "test/**/*.ts"],
  "exclude": ["node_modules", "docs", "dist"]
}
